MW_prop <- MW %>%
select(participant, Block, MW_index, MW_label, task) %>%
filter(!is.na(MW_label)) %>%
group_by(participant, Block, MW_index, task) %>%
summarize(
MW_label = mean(MW_label),
n_unique = n_distinct(MW_label),
.groups = "drop"
)
# This should return zero rows
MW_prop %>%
filter(n_unique != 1)
# This should show only 0 and 1
table(MW_prop$MW_binary, useNA = "ifany")
# This should show only 0 and 1
table(MW_prop$MW_label, useNA = "ifany")
# Number of probes contributed by each participant
MW_prop %>%
count(participant)
MW_prop <- MW_prop %>%
mutate(
participant = factor(participant),
Block = factor(Block),
task = factor(task)
)
levels(MW_prop$task)
levels(MW_prop$Block)
MW_prop$task <- relevel(MW_prop$task, ref = "1")
MW_prop$Block <- relevel(MW_prop$Block, ref = "1")
MW_prop$task <- factor(
MW_prop$task,
levels = c(1, 2, 3),
labels = c("No-Break", "Rest-Break", "Task-Switch")
)
mf_model <- glmer(
MW_binary ~ task * Block + (1 | participant),
data = MW_prop,
family = binomial(link = "logit")
)
mf_model <- glmer(
MW_label ~ task * Block + (1 | participant),
data = MW_prop,
family = binomial(link = "logit")
)
summary(mf_model)
mf_model <- glmer(
MW_label ~ task * Block + (1 | participant),
data = MW_prop,
family = binomial(link = "logit")
)
summary(mf_model)
mf_model_bobyqa <- glmer(
MW_binary ~ task * Block + (1 | participant),
data = MW_prop,
family = binomial(link = "logit"),
control = glmerControl(
optimizer = "bobyqa",
optCtrl = list(maxfun = 200000)
)
)
